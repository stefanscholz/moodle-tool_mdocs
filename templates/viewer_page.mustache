{{!
    @template tool_mdocs/viewer_page

    Single-document viewer: sidebar tree, rendered content and table of contents.

    Example context (json):
    {
        "title": "Overview",
        "indexurl": "https://example.com/admin/tool/mdocs/index.php",
        "contenthtml": "<h1 id=\"overview\">Overview</h1><p>Hello.</p>",
        "hastoc": true,
        "toclabel": "On this page",
        "sourcelabel": "Source: mod_forum/readme.md",
        "toc": [{"text": "Overview", "id": "overview", "indent": "tool-mdocs-toc-l1"}],
        "tree": [
            {
                "displayname": "Forum",
                "hasactive": true,
                "docs": [{"title": "Overview", "url": "https://example.com/view.php", "active": true}]
            }
        ]
    }
}}
<div class="tool-mdocs-viewer">
    <div class="row">
        <nav class="col-lg-3 tool-mdocs-sidebar mb-3" aria-label="{{#str}}documentationcenter, tool_mdocs{{/str}}">
            <a href="{{indexurl}}" class="d-inline-block mb-2">&laquo; {{#str}}backtoindex, tool_mdocs{{/str}}</a>
            <label class="sr-only" for="tool-mdocs-filter">{{#str}}filterplaceholder, tool_mdocs{{/str}}</label>
            <input type="text" id="tool-mdocs-filter" class="form-control form-control-sm mb-2"
                   data-region="mdocs-filter" placeholder="{{#str}}filterplaceholder, tool_mdocs{{/str}}" autocomplete="off">
            <ul class="list-unstyled tool-mdocs-tree mb-0">
                {{#tree}}
                    <li class="tool-mdocs-tree-group {{#hasactive}}tool-mdocs-open{{/hasactive}}" data-region="mdocs-group">
                        <button type="button" class="btn btn-link p-0 text-left tool-mdocs-group-toggle" data-action="toggle">
                            {{displayname}}
                        </button>
                        <ul class="list-unstyled pl-3 tool-mdocs-tree-docs">
                            {{#docs}}
                                <li data-region="mdocs-doc">
                                    <a href="{{url}}" class="{{#active}}font-weight-bold tool-mdocs-active{{/active}}">{{title}}</a>
                                </li>
                            {{/docs}}
                        </ul>
                    </li>
                {{/tree}}
            </ul>
        </nav>

        <main class="col-lg-6 tool-mdocs-content">
            <div class="tool-mdocs-markdown">
                {{{contenthtml}}}
            </div>
            <p class="text-muted small mt-4 mb-0">{{sourcelabel}}</p>
        </main>

        {{#hastoc}}
            <aside class="col-lg-3 tool-mdocs-toc mb-3" aria-label="{{toclabel}}">
                <div class="tool-mdocs-toc-sticky">
                    <h2 class="h6 text-uppercase text-muted">{{toclabel}}</h2>
                    <ul class="list-unstyled">
                        {{#toc}}
                            <li class="{{indent}}"><a href="#{{id}}" data-mdocs-toc="{{id}}">{{text}}</a></li>
                        {{/toc}}
                    </ul>
                </div>
            </aside>
        {{/hastoc}}
    </div>
</div>
{{#js}}
require(['tool_mdocs/sidebar', 'tool_mdocs/toc'], function(Sidebar, Toc) {
    Sidebar.init();
    Toc.init();
});
{{/js}}
