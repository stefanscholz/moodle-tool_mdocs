{{!
    @template tool_mdocs/toc_block

    Contents of the "On this page" fake block: the table of contents for the
    document currently being viewed.

    Example context (json):
    {
        "toc": [
            {"text": "Overview", "id": "overview", "indent": "tool-mdocs-toc-l1"},
            {"text": "Details", "id": "details", "indent": "tool-mdocs-toc-l2"}
        ]
    }
}}
<ul class="list-unstyled mb-0 tool-mdocs-toc-list">
    {{#toc}}
        <li class="{{indent}}"><a href="#{{id}}" data-mdocs-toc="{{id}}">{{text}}</a></li>
    {{/toc}}
</ul>
