{{!
    @template tool_mdocs/index_page

    Documentation Center landing page.

    Example context (json):
    {
        "hasdocs": true,
        "countlabel": "3 document(s)",
        "lastindexed": "Last indexed: 1 January 2026",
        "canmanage": true,
        "rebuildurl": "https://example.com/admin/tool/mdocs/index.php",
        "sesskey": "abc123",
        "nodocsmessage": "No documentation was found.",
        "components": [
            {
                "component": "mod_videotime",
                "displayname": "Video Time",
                "hasdocs": true,
                "docs": [{"title": "Overview", "url": "https://example.com/view.php"}],
                "subgroups": [
                    {
                        "component": "videotimeplugin_analysis",
                        "displayname": "Analysis",
                        "docs": [{"title": "Admin guide", "url": "https://example.com/view.php"}]
                    }
                ]
            }
        ]
    }
}}
<div class="tool-mdocs-index">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <div class="text-muted">{{countlabel}} &middot; {{lastindexed}}</div>
        {{#canmanage}}
            <form method="post" action="{{rebuildurl}}" class="m-0">
                <input type="hidden" name="rebuild" value="1">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <button type="submit" class="btn btn-secondary">{{#str}}rebuildindex, tool_mdocs{{/str}}</button>
            </form>
        {{/canmanage}}
    </div>

    {{#hasdocs}}
        <div class="tool-mdocs-search mb-4 position-relative">
            <label class="sr-only" for="tool-mdocs-search-input">{{#str}}searchdocs, tool_mdocs{{/str}}</label>
            <input type="text" class="form-control" id="tool-mdocs-search-input"
                   placeholder="{{#str}}searchplaceholder, tool_mdocs{{/str}}" autocomplete="off">
            <div id="tool-mdocs-search-results" class="list-group tool-mdocs-search-results" hidden></div>
        </div>

        <div class="row">
            {{#components}}
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h3 class="card-title h5 mb-1">{{displayname}}</h3>
                            <p class="text-muted small mb-2">{{component}}</p>
                            {{#hasdocs}}
                                <ul class="list-unstyled mb-0">
                                    {{#docs}}
                                        <li class="mb-1"><a href="{{url}}">{{title}}</a></li>
                                    {{/docs}}
                                </ul>
                            {{/hasdocs}}
                            {{#subgroups}}
                                <div class="tool-mdocs-subgroup mt-2">
                                    <h4 class="h6 text-muted mb-1">{{displayname}}</h4>
                                    <ul class="list-unstyled mb-0">
                                        {{#docs}}
                                            <li class="mb-1"><a href="{{url}}">{{title}}</a></li>
                                        {{/docs}}
                                    </ul>
                                </div>
                            {{/subgroups}}
                        </div>
                    </div>
                </div>
            {{/components}}
        </div>
    {{/hasdocs}}
    {{^hasdocs}}
        <div class="alert alert-info">{{nodocsmessage}}</div>
    {{/hasdocs}}
</div>
{{#js}}
require(['tool_mdocs/search'], function(Search) {
    Search.init('tool-mdocs-search-input', 'tool-mdocs-search-results');
});
{{/js}}
